# Server-only calendar availability sources.
# Use real values in .env.local or deployment secrets; do not commit private ICS URLs.
AVAILABILITY_ICS_URLS_JSON='["https://example.com/calendar.ics","webcal://example.com/calendar.ics"]'
AVAILABILITY_ICS_FILE_PATHS_JSON='["private/availability/example.ics"]'

# Optional fetch/read limits.
AVAILABILITY_ICS_TIMEOUT_MS=7000
AVAILABILITY_ICS_MAX_BYTES=2000000

# Cloudflare Access mode (production): set all three. /admin then requires a valid Access JWT on
# ADMIN_HOST (other hosts redirect there) and Basic Auth is not used. Missing team/AUD denies access.
# ADMIN_HOST=admin.example.com
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=application-audience-tag

# Basic Auth fallback, used only when ADMIN_HOST is unset (local dev, break-glass).
# Required then to access /admin and Sveltia static assets. Copying this placeholder leaves admin disabled.
# Generate a unique password with: openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
